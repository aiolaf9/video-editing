# Profil Hostinger KVM 2 (2 vCPU, 8 GB RAM, tanpa GPU) untuk pengujian terbatas.
# Pakai:  cp deploy/kvm2.env.example .env   (lalu isi bagian "Wajib diisi")
#         docker compose -f docker-compose.yml -f deploy/compose.kvm2.yml up -d --build
# Bila VPS sudah punya web server (port 80/443 terpakai), tambahkan: -f deploy/compose.behind-proxy.yml
# Panduan: docs/DEPLOY_KVM2.md

# ===== Wajib diisi =====
DOMAIN=editvideo.contoh.id
# openssl rand -hex 24
POSTGRES_PASSWORD=ganti-dengan-password-acak
ADMIN_EMAIL=admin@contoh.id
ADMIN_PASSWORD=ganti-password-admin

# ===== Anggaran CPU/RAM (2 vCPU / 8 GB) =====
# Satu analisis + satu render paling banyak berjalan bersamaan; masing-masing dibatasi 1,5 vCPU sehingga tidak ada
# yang memakai seluruh CPU, dan render didahulukan saat CPU diperebutkan (cpu_shares di docker-compose.yml).
# Perkiraan RAM: analisis 2 GB + render 1,5 GB + io 0,5 GB + web 0,75 GB + database 0,5 GB + Caddy 0,13 GB
# ≈ 5,4 GB batas maksimum; sisa ±2,5 GB untuk sistem operasi dan layanan lain di VPS.
WEB_WORKERS=2
ANALYSIS_WORKERS=1
ANALYSIS_QUEUES=analisis
ANALYSIS_CPUS=1.5
ANALYSIS_MEM=2g
RENDER_WORKERS=1
RENDER_CPUS=1.5
RENDER_MEM=1500m
IO_CPUS=0.25
IO_MEM=512m
MAX_CONCURRENT_ANALYSES=1
MAX_CONCURRENT_RENDERS=1
# Sisakan RAM host untuk OS & layanan lain: job baru ditunda bila RAM tersedia di host kurang dari ini.
MEM_RESERVE_MB=1024

# ===== Transkripsi (AI lokal, tanpa GPU) =====
# "base" + mode per potongan ucapan: titik awal yang cukup cepat di 2 vCPU. Naikkan ke "small" bila mutu kurang
# dan waktu analisis masih dapat diterima.
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_CHUNKED=1
# Video maksimal 15 menit (ditolak dengan pesan jelas di browser & server).
MAX_VIDEO_SECONDS=900

# ===== Antrean =====
MAX_PENDING_PER_USER=3
MAX_QUEUED_PER_UNIT=10
MAX_QUEUE_DEPTH=30
# Tolak pekerjaan baru bila tidak ada worker hidup (bawaan aktif).
REQUIRE_LIVE_WORKER=1

# ===== Media sementara (bawaan AI Video Studio) =====
# Dihapus 2 jam setelah aktivitas terakhir, paling lama 5 jam sejak upload. Hasil render diunduh manual.
MEDIA_RETENTION_HOURS=2
MEDIA_MAX_HOURS=5
MEDIA_WARN_HOURS=0.5
CLEANUP_INTERVAL=300
MAX_UPLOAD_MB=2048

# ===== Kebijakan lain =====
ALLOW_URL_IMPORT=admins
URL_IMPORT_TRUSTED_NETWORKS=
