# ===== Wajib diisi =====
# Domain yang diarahkan ke IP server (untuk HTTPS otomatis). Untuk uji tanpa domain: DOMAIN=:80 dan COOKIE_SECURE=0
DOMAIN=video.kantor-anda.id
# Password database (acak & panjang). Contoh membuat: openssl rand -hex 24
POSTGRES_PASSWORD=ganti-dengan-password-acak
# Akun Admin pertama (dibuat otomatis saat pertama kali jalan). Ganti password setelah login.
ADMIN_EMAIL=admin@kantor-anda.id
ADMIN_PASSWORD=ganti-password-admin

# ===== Kapasitas (sesuaikan dengan server) =====
# Contoh untuk VPS 8 vCPU / 16 GB RAM:
WEB_WORKERS=2
HEAVY_WORKERS=3
# Thread CPU per proses Whisper ≈ jumlah vCPU / HEAVY_WORKERS
WHISPER_THREADS=2
# tiny | base | small | medium. "small" = akurat & masih wajar di CPU.
WHISPER_MODEL=small
WHISPER_DEVICE=cpu

# ===== Batas & kebijakan =====
MAX_UPLOAD_MB=2048
# Pekerjaan antre/berjalan maksimal per pengguna
MAX_PENDING_PER_USER=5
# Ambil video dari link: all | admins (Admin & Admin Unit) | none
ALLOW_URL_IMPORT=admins
# Hapus proyek lebih tua dari N hari (hemat disk). 0 = tidak pernah.
RETENTION_DAYS=30
SESSION_DAYS=14
COOKIE_SECURE=1

# ===== Opsional: API key AI (bisa juga diisi di halaman Admin) =====
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
