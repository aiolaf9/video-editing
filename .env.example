# ===== Wajib diisi =====
# Domain yang diarahkan ke IP server (untuk HTTPS otomatis). Untuk uji tanpa domain: DOMAIN=:80 dan COOKIE_SECURE=0
DOMAIN=video.kantor-anda.id
# Password database (acak & panjang). Contoh membuat: openssl rand -hex 24
POSTGRES_PASSWORD=ganti-dengan-password-acak
# Akun Admin pertama (dibuat otomatis saat pertama kali jalan). Ganti password setelah login.
ADMIN_EMAIL=admin@kantor-anda.id
ADMIN_PASSWORD=ganti-password-admin

# ===== Kapasitas (sesuaikan dengan server; lihat "Kelas server" di DEPLOY.md) =====
# Contoh untuk VPS 8 vCPU / 16 GB RAM:
WEB_WORKERS=2
# Worker per antrean. cpus = batas core per worker (boleh total > jumlah vCPU), MEM = batas RAM.
# worker-analisis mengutamakan analisis dan ikut merender saat tidak ada analisis (hibrida)
ANALYSIS_WORKERS=2
ANALYSIS_CPUS=4
ANALYSIS_MEM=3g
# ANALYSIS_QUEUES=analisis,render   (isi "analisis" untuk worker analisis murni)
RENDER_WORKERS=2
RENDER_CPUS=3
RENDER_MEM=1500m
# tiny | base | small | medium. "small" = akurat & masih wajar di CPU.
WHISPER_MODEL=small
# auto = GPU NVIDIA hanya bila terdeteksi dengan VRAM cukup, selain itu CPU
WHISPER_DEVICE=auto
# Thread Whisper/FFmpeg diatur otomatis per worker (0). Isi angka hanya bila perlu nilai tetap.
# WHISPER_THREADS=0
# WORKER_THREADS=0

# ===== Antrean & keadilan antar-unit =====
# Job menunggu per unit per antrean (lebih dari ini: "antrean unit penuh", 429)
# MAX_QUEUED_PER_UNIT=30
# Job menunggu per antrean di seluruh server (lebih dari ini: "server sibuk", 503)
# MAX_QUEUE_DEPTH=300
# Job berjalan bersamaan per unit per antrean (0 = tanpa batas)
# MAX_RUNNING_PER_UNIT=3
# Batas job berjalan bersamaan di seluruh server (0 = sebanyak worker)
# MAX_CONCURRENT_RENDERS=0
# MAX_CONCURRENT_ANALYSES=0
# Prioritas job naik 1 tingkat per N detik menunggu (mencegah job tertahan selamanya)
# AGING_SECONDS=60
# Cadangan RAM yang selalu disisakan; job ditunda bila RAM tersedia kurang
# MEM_RESERVE_MB=512
# Token untuk /metrics (Prometheus). Kosong = mati.
# METRICS_TOKEN=

# ===== Batas & kebijakan =====
MAX_UPLOAD_MB=2048
# Pekerjaan antre/berjalan maksimal per pengguna
MAX_PENDING_PER_USER=5
# Ambil video dari link: all | admins (Admin & Admin Unit) | none
ALLOW_URL_IMPORT=admins
# Impor dari link hanya ke alamat IP publik (anti-SSRF). Jaringan internal tepercaya (CIDR, dipisah koma) hanya
# berlaku untuk impor oleh Admin global, mis. 10.20.0.0/16. Kosongkan bila tidak perlu.
URL_IMPORT_TRUSTED_NETWORKS=
# Batas ukuran video dari link (MB, bawaan = MAX_UPLOAD_MB) dan jumlah pengalihan (redirect) per permintaan
URL_IMPORT_MAX_MB=2048
URL_IMPORT_MAX_REDIRECTS=5
# Proxy keluar khusus unduhan (opsional). Bila diisi, proxy itu yang WAJIB memblokir alamat internal.
DOWNLOAD_PROXY=
SESSION_DAYS=14
COOKIE_SECURE=1

# ===== Opsional: API key AI (bisa juga diisi di halaman Admin) =====
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ===== Penyimpanan media sementara =====
# Video, preview, dan hasil render TIDAK disimpan permanen. Media dihapus otomatis
# MEDIA_RETENTION_HOURS setelah aktivitas terakhir, paling lama MEDIA_MAX_HOURS sejak upload.
# Media yang sedang dipakai pekerjaan aktif tidak pernah dihapus. Metadata (akun, unit, tema, Guidebook) tetap ada.
# MEDIA_LIFECYCLE=1
# MEDIA_RETENTION_HOURS=24
# MEDIA_MAX_HOURS=72
# Peringatan "akan dihapus" ditampilkan N jam sebelumnya
# MEDIA_WARN_HOURS=3
# Interval pembersihan otomatis (detik)
# CLEANUP_INTERVAL=300
# Upload baru ditolak bila sisa disk di bawah salah satu batas ini
# DISK_MIN_FREE_MB=2048
# DISK_MIN_FREE_PCT=5
# Kuota media sementara per unit (MB). 0 = tanpa batas. Bisa diubah per unit di Admin -> Unit.
# STORAGE_QUOTA_MB_DEFAULT=0

# ===== Upload & preview (P4) =====
# Upload terputus bisa dilanjutkan selama N jam sejak aktivitas terakhir
# UPLOAD_RESUME_HOURS=12
# MAX_ACTIVE_UPLOADS_PER_USER=4
# Preview tanpa transcode bila sumber sudah ramah browser (H.264/AAC, tinggi & bitrate di bawah batas)
# PREVIEW_COPY_MAX_HEIGHT=720
# PREVIEW_COPY_MAX_KBPS=4000
# Video lebih panjang dari ini (menit): preview 360p + dekode cepat. 0 = tidak dipakai.
# PREVIEW_LONG_MINUTES=20
# Dekode hardware untuk preview: none | auto | cuda | vaapi | qsv (gagal = kembali ke CPU)
# PREVIEW_HWACCEL=none

# ===== Database =====
# Migrasi skema otomatis saat start. Kosong = otomatis untuk SQLite, TIDAK untuk PostgreSQL
# (server: service `migrate` / python -m app.manage db-upgrade setelah backup).
# AUTO_MIGRATE=

# ===== Batas waktu pekerjaan (opsional; nilai bawaan sudah aman untuk server CPU) =====
# Analisis: ANALYZE_TIMEOUT_BASE + ANALYZE_TIMEOUT_PER_MIN x durasi video (menit), maks JOB_TIMEOUT_MAX
# ANALYZE_TIMEOUT_BASE=900
# ANALYZE_TIMEOUT_PER_MIN=180
# Render: RENDER_TIMEOUT_BASE + RENDER_TIMEOUT_PER_SEC x durasi hasil (detik)
# RENDER_TIMEOUT_BASE=300
# RENDER_TIMEOUT_PER_SEC=20
# DOWNLOAD_TIMEOUT=3600
# JOB_TIMEOUT_MAX=21600
# FFmpeg tanpa kemajuan selama N detik dianggap macet dan dihentikan
# FFMPEG_STALL_TIMEOUT=300
# Bila job tidak berhenti N detik setelah dibatalkan/timeout, worker me-restart dirinya
# CANCEL_GRACE=90
